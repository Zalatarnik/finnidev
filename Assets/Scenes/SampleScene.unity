  - {fileID: -8607005669353761045, guid: 6aec4d02091539a418e406e348ebc9b6, type: 3}
  textTemplates:
  - {fileID: 8175621209545084163}
  - {fileID: 8175621209545084163}
  - {fileID: 8284089009018165706}
  - {fileID: 390347766872551705}
  - {fileID: 4594372072548138507}
  - {fileID: 3584851728814005700}
  textFlyDuration: 0.5
  dialogCharacterImage: {fileID: 3006757699599409393}
  dialogBoxImage: {fileID: 0}
  dialogTextComponent: {fileID: 9114461324847689097}
  textTypingSpeed: 0.03
  dialogLines:
  - characterSprite: {fileID: -6651285785684280604, guid: 6c4e1c9fbb2422441841b9e8a88e84f1, type: 3}
    dialogBoxSprite: {fileID: 7669455987791779220, guid: bbf55e4231037804db49b295bd04f9b1, type: 3}
    dialogText: "\u0427\u0442\u043E \u0437\u0430 \u044F\u0440\u043A\u0438\u0439 \u0441\u0432\u0435\u0442?"
  - characterSprite: {fileID: -6651285785684280604, guid: 6c4e1c9fbb2422441841b9e8a88e84f1, type: 3}
    dialogBoxSprite: {fileID: 7669455987791779220, guid: bbf55e4231037804db49b295bd04f9b1, type: 3}
    dialogText: "\u0410\u0430\u0430!? \u0422\u044B \u043A\u0442\u043E \u0442\u0430\u043A\u043E\u0439??? \u0422\u044B \u043E\u0442\u043A\u0443\u0434\u0430 \u0432\u0437\u044F\u043B\u0441\u044F?"
  - characterSprite: {fileID: 2829232388215122354, guid: aeefdf49213eb6449a29c14125515503, type: 3}
    dialogBoxSprite: {fileID: 2317827250201692963, guid: a8ada16681e5bcc4ab560ea723c0c69f, type: 3}
    dialogText: "\u0424\u0438\u043D\u043D\u0438 \u0444\u0438-\u0440\u0438-\u0440\u0438! \u0424\u0438 \u0440\u0430 \u043D\u0438-\u0440\u0438..."
  - characterSprite: {fileID: 2785550544401906418, guid: 505ef160423e6274c8bfc6b90e42a653, type: 3}
    dialogBoxSprite: {fileID: 7669455987791779220, guid: bbf55e4231037804db49b295bd04f9b1, type: 3}
    dialogText: "\u041A\u0430\u043A\u043E\u0439 \u043C\u0438\u043B\u0430\u0448! \u041A\u0430\u043A \u0442\u0435\u0431\u044F \u0437\u043E\u0432\u0443\u0442?"
  - characterSprite: {fileID: 2829232388215122354, guid: aeefdf49213eb6449a29c14125515503, type: 3}
    dialogBoxSprite: {fileID: 2317827250201692963, guid: a8ada16681e5bcc4ab560ea723c0c69f, type: 3}
    dialogText: "\u0424\u0438\u043D\u043D\u0438! \u0424\u0438\u043D\u043D\u0438! \u041D\u0438 \u0440\u0430 \u0444\u0430\u043D\u0430!"
  - characterSprite: {fileID: 5225557550362909137, guid: 1fcf7df55f6c151499231ced553feb7c, type: 3}
    dialogBoxSprite: {fileID: 7669455987791779220, guid: bbf55e4231037804db49b295bd04f9b1, type: 3}
    dialogText: "\u0425\u043C... \u042F \u0442\u0435\u0431\u044F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0431\u0443\u0434\u0443 \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0442\u043E\u0433\u0434\u0430 \u0424\u0438\u043D\u043D\u0438."
  - characterSprite: {fileID: 2829232388215122354, guid: aeefdf49213eb6449a29c14125515503, type: 3}
    dialogBoxSprite: {fileID: -1893984790920366816, guid: cf818e54eaf8307439572db41aaae226, type: 3}
    dialogText: "\u0424\u0438\u043D\u043D\u0438..."
  - characterSprite: {fileID: -6928365714507401850, guid: 26ae28c267663fd4b9140b73a6341530, type: 3}
    dialogBoxSprite: {fileID: 7669455987791779220, guid: bbf55e4231037804db49b295bd04f9b1, type: 3}
    dialogText: "\u0422\u0443\u0442 \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435, \u043D\u043E \u044F \u0435\u0449\u0451 \u043D\u0435 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B..."
  mainPlayerPrefab: {fileID: 6976882751313341239, guid: e8242db111c19c741b0b7be63fedc117, type: 3}
